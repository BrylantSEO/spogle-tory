{
  "name": "TrackSegment",
  "type": "object",
  "properties": {
    "segment_id": {
      "type": "string",
      "description": "ID segmentu np. tor12, tor20, tor27, tor28, atomic-drop, duo"
    },
    "name": {
      "type": "string",
      "description": "Nazwa wyświetlana np. Tor 12m"
    },
    "description": {
      "type": "string",
      "description": "Opis toru widoczny w szczegółach"
    },
    "cover_image": {
      "type": "string",
      "description": "URL zdjęcia głównego (na karcie i w nagłówku modala)"
    },
    "gallery_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista URL zdjęć do galerii w modalu szczegółów"
    },
    "promo_video_url": {
      "type": "string",
      "description": "URL YouTube filmu promocyjnego (embed URL lub watch URL)"
    },
    "price_3h": {
      "type": "number",
      "description": "Cena za 3 godziny (zł netto)"
    },
    "price_4h": {
      "type": "number",
      "description": "Cena za 4 godziny (zł netto)"
    },
    "price_5h": {
      "type": "number",
      "description": "Cena za 5 godzin (zł netto)"
    },
    "price_6h": {
      "type": "number",
      "description": "Cena za 6 godzin (zł netto)"
    },
    "price_8h": {
      "type": "number",
      "description": "Cena za 8 godzin (zł netto)"
    },
    "blowers_count": {
      "type": "number",
      "description": "Liczba dmuchaw potrzebnych do segmentu"
    },
    "blower_power_kw": {
      "type": "number",
      "description": "Moc jednej dmuchawy w kW"
    },
    "total_power_kw": {
      "type": "number",
      "description": "Łączna moc poboru prądu segmentu w kW"
    }
  },
  "required": [
    "segment_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
