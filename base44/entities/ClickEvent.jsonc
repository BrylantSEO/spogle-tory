{
  "name": "ClickEvent",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Reference to the PageSession session_id"
    },
    "event_name": {
      "type": "string",
      "description": "Name of the event"
    },
    "event_data": {
      "type": "string",
      "description": "JSON string with extra event parameters"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the event occurred"
    },
    "time_since_load_seconds": {
      "type": "number",
      "description": "Seconds elapsed since page load"
    },
    "scroll_position": {
      "type": "number",
      "description": "Scroll position at time of event (percentage 0-100)"
    },
    "x_position": {
      "type": "number",
      "description": "X coordinate of click in pixels"
    },
    "y_position": {
      "type": "number",
      "description": "Y coordinate of click in pixels"
    }
  },
  "required": [
    "session_id",
    "event_name"
  ]
}