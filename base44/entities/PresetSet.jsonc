{
  "name": "PresetSet",
  "type": "object",
  "properties": {
    "set_id": {
      "type": "string",
      "description": "Unikalny identyfikator setu np. legia, tor4u, gigant"
    },
    "name": {
      "type": "string",
      "description": "Nazwa setu"
    },
    "image": {
      "type": "string",
      "description": "URL zdjęcia głównego"
    },
    "price_label": {
      "type": "string",
      "description": "Etykieta ceny domyślnej np. '5000' lub 'Wycena indywidualna'"
    },
    "price_5h": {
      "type": "number",
      "description": "Cena za 5 godzin (zł netto)"
    },
    "price_6h": {
      "type": "number",
      "description": "Cena za 6 godzin (zł netto)"
    },
    "price_8h": {
      "type": "number",
      "description": "Cena za 8 godzin (zł netto)"
    },
    "power_kw": {
      "type": "number",
      "description": "Łączna moc w kilowatach (kW) potrzebna do podłączenia setu"
    },
    "setup_time_minutes": {
      "type": "number",
      "description": "Czas montażu setu w minutach"
    },
    "blowers_count": {
      "type": "number",
      "description": "Liczba dmuchaw potrzebnych do setu"
    },
    "blower_power_kw": {
      "type": "number",
      "description": "Moc jednej dmuchawy w kW"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista nazw elementów w secie np. ['Tor 20m', 'Tor 27m']"
    },
    "animators_included": {
      "type": "number",
      "description": "Liczba animatorów wliczona w cenę"
    },
    "sort_order": {
      "type": "number",
      "description": "Kolejność wyświetlania"
    }
  },
  "required": [
    "set_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
