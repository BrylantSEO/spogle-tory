{
  "name": "PresetSet",
  "type": "object",
  "properties": {
    "set_id": {
      "type": "string",
      "description": "Unikalny identyfikator setu np. legia, tor4u, gigant"
    },
    "name": {
      "type": "string",
      "description": "Nazwa setu"
    },
    "image": {
      "type": "string",
      "description": "URL zdj\u0119cia g\u0142\u00f3wnego"
    },
    "price_label": {
      "type": "string",
      "description": "Etykieta ceny domy\u015blnej np. '5000' lub 'Wycena indywidualna'"
    },
    "price_5h": {
      "type": "number",
      "description": "Cena za 5 godzin (z\u0142 netto)"
    },
    "price_6h": {
      "type": "number",
      "description": "Cena za 6 godzin (z\u0142 netto)"
    },
    "price_8h": {
      "type": "number",
      "description": "Cena za 8 godzin (z\u0142 netto)"
    },
    "power_kw": {
      "type": "number",
      "description": "\u0141\u0105czna moc w kilowatach (kW) potrzebna do pod\u0142\u0105czenia setu"
    },
    "setup_time_minutes": {
      "type": "number",
      "description": "Czas monta\u017cu setu w minutach"
    },
    "blowers_count": {
      "type": "number",
      "description": "Liczba dmuchaw potrzebnych do setu"
    },
    "blower_power_kw": {
      "type": "number",
      "description": "Moc jednej dmuchawy w kW"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista nazw element\u00f3w w secie np. ['Tor 20m', 'Tor 27m']"
    },
    "animators_included": {
      "type": "number",
      "description": "Liczba animator\u00f3w wliczona w cen\u0119"
    },
    "sort_order": {
      "type": "number",
      "description": "Kolejno\u015b\u0107 wy\u015bwietlania"
    }
  },
  "required": [
    "set_id",
    "name"
  ]
}