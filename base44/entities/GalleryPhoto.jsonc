{
  "name": "GalleryPhoto",
  "type": "object",
  "properties": {
    "src": {
      "type": "string",
      "description": "URL zdjęcia (puste jeśli to film)"
    },
    "video_url": {
      "type": "string",
      "description": "URL YouTube (embed) lub plik wideo — wyświetlane zamiast zdjęcia"
    },
    "alt": {
      "type": "string",
      "description": "Tytuł / opis zdjęcia"
    },
    "description": {
      "type": "string",
      "description": "Opis zdjęcia widoczny w galerii"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista segmentów widocznych na zdjęciu"
    },
    "total_meters": {
      "type": "string",
      "description": "Łączna liczba metrów np. '97m'"
    },
    "price_label": {
      "type": "string",
      "description": "Cena setu np. 'od 2 897 zł' lub 'Wycena indywidualna'"
    },
    "hotpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "description": "Hotpointy na zdjęciu"
    },
    "sort_order": {
      "type": "number",
      "description": "Kolejność wyświetlania"
    }
  },
  "required": [
    "alt"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
